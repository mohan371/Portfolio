# =============================================================================
# Mohan N.V. Portfolio Platform — Environment Configuration Template
# Copy this file to .env.local and populate with your verified credentials.
# =============================================================================

# -----------------------------------------------------------------------------
# SUPABASE PUBLIC CONFIGURATION (Safe for browser / Client Components)
# -----------------------------------------------------------------------------
# Your Supabase Project REST URL (e.g., https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"

# Your Supabase Anonymous Public API Key (Safe to expose to client browsers)
# Protected strictly by Row Level Security (RLS) policies defined in migrations
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here"

# -----------------------------------------------------------------------------
# SUPABASE PRIVILEGED CONFIGURATION (STRICTLY SERVER-ONLY)
# -----------------------------------------------------------------------------
# WARNING: NEVER prefix with NEXT_PUBLIC.
# NEVER import or use in Client Components.
# Used exclusively for privileged administrative migrations, maintenance scripts,
# or backend background workers.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here"

# -----------------------------------------------------------------------------
# SITE & DEPLOYMENT METADATA
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Mohan N.V. // Systems Architect"
